<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.1.2 Chrome/138.0.7204.243 Electron/37.4.0 Safari/537.36" version="28.1.2">
  <diagram id="shape_det_pipeline" name="Shape Detection Pipeline">
    <mxGraphModel dx="1665" dy="875" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;1. Image Input&lt;/b&gt;&lt;br&gt;Load Traffic Sign Image from Dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;2. Preprocessing&lt;/b&gt;&lt;br&gt;BGR → RGB → Gaussian Blur → HSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="130" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="3. Color-Specific HSV Segmentation&amp;nbsp;&lt;div&gt;(Apply Red / Blue / Yellow segmentation based on dataset category)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="260" y="220" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;4. Contour Extraction &amp;amp; Scoring&lt;/b&gt;&lt;br&gt;Filter Area &amp;ge; 1000 &amp;rarr; Select Best Contour by Geometric Score&lt;br&gt;&lt;i&gt;Score = Area &amp;times; Circularity &amp;times; Solidity&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="230" y="310" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;5. Polygon Approximation &amp;amp; Feature Extraction&lt;/b&gt;&lt;br&gt;(Douglas-Peucker,&lt;br/&gt;epsilon = 0.018 × perimeter)&amp;nbsp;&lt;div&gt;Extract:&amp;nbsp; Area, Perimeter, Circularity, Vertices, Aspect Ratio&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="410" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;6. Rule-Based Shape Classification&lt;/b&gt;&lt;br&gt;(Vertices + Circularity + Aspect Ratio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="510" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="81" value="&lt;b&gt;Triangle&lt;/b&gt;&lt;br&gt;(Vertices == 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="82" value="&lt;b&gt;Square / Rect&lt;/b&gt;&lt;br&gt;(Vertices == 4 &amp;amp;&amp;nbsp; Aspect Ratio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="190" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="83" value="&lt;b&gt;Circle&lt;/b&gt;&lt;br&gt;(Circularity &amp;ge; 0.82)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="610" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="84" value="&lt;b&gt;Octagon&lt;/b&gt;&lt;br&gt;(Vertices 7 - 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="500" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="85" value="&lt;b&gt;Unknown&lt;/b&gt;&lt;br&gt;(Other shapes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="610" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;7. Output Visualization&lt;/b&gt;&lt;br&gt;Annotate Green Contour &amp;amp; Blue Shape Label on RGB Image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="260" y="700" width="320" height="60" as="geometry" />
