        <!-- Nodes -->
        <mxCell id="2" value="&lt;b&gt;1. Image Input&lt;/b&gt;&lt;br&gt;Load Traffic Sign Image from Dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="3" value="&lt;b&gt;2. Preprocessing&lt;/b&gt;&lt;br&gt;BGR &amp;rarr; RGB &amp;rarr; Gaussian Blur (5x5) &amp;rarr; HSV Color Space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="280" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="4" value="&lt;b&gt;3. Multi-Color HSV Segmentation&lt;/b&gt;&lt;br&gt;Combine Red, Blue &amp;amp; Yellow HSV Threshold Masks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="320" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="5" value="&lt;b&gt;4. Contour Extraction &amp;amp; Scoring&lt;/b&gt;&lt;br&gt;Filter Area &amp;ge; 1000 &amp;rarr; Select Best Contour by Geometric Score&lt;br&gt;&lt;i&gt;Score = Area &amp;times; Circularity &amp;times; Solidity&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="310" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="6" value="&lt;b&gt;5. Polygon Approximation &amp;amp; Features&lt;/b&gt;&lt;br&gt;Convex Hull &amp;rarr; Douglas-Peucker Approx (cv2.approxPolyDP)&lt;br&gt;Extract Vertices Count, Circularity &amp;amp; Aspect Ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="410" width="400" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="7" value="&lt;b&gt;6. Shape Classification Logic&lt;/b&gt;&lt;br&gt;Decision Rules based on Vertices &amp;amp; Circularity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="510" width="280" height="60" as="geometry" />
        </mxCell>
        
        <!-- Shape branches -->
