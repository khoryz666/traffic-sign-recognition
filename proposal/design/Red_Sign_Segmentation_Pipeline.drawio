          <mxGeometry x="240" y="350" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="6" value="&lt;b&gt;5. Morphological Cleaning&lt;/b&gt;&lt;br&gt;Morphological Opening (3x3 Ellipses) to Detach Noise&lt;br&gt;Morphological Closing (5x5 Ellipses) to Bridge Gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
