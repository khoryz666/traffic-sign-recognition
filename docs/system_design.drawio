        <mxCell id="Q0QoaTnIvaRrZKtoSYU5-119" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="85" target="9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="845" y="730" as="sourcePoint" />
            <mxPoint x="670" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="red_seg_pipeline" name="Red Color Segmentation Pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Nodes -->
        <mxCell id="2" value="&lt;b&gt;1. Image Input&lt;/b&gt;&lt;br&gt;Load RGB Traffic Sign Image (cv2.imread)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="3" value="&lt;b&gt;2. Preprocessing&lt;/b&gt;&lt;br&gt;Gaussian Blur (5x5 Kernel) for Noise Suppression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="4" value="&lt;b&gt;3. Color Space &amp; Difference Mapping&lt;/b&gt;&lt;br&gt;Raw Redness: max(0, R - max(G,B))&lt;br&gt;Weighted by HSV Saturation Tolerance &amp; Normalized (0-255)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="240" width="340" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="5" value="&lt;b&gt;4. Adaptive Color Thresholding&lt;/b&gt;&lt;br&gt;Otsu&#39;s Automatic Binarization (cv2.THRESH_OTSU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="350" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="6" value="&lt;b&gt;5. Morphological Cleaning&lt;/b&gt;&lt;br&gt;Morphological Opening (3x3 Ellipses) to Detach Noise&lt;br&gt;Morphological Closing (5x5 Ellipses) to Bridge Gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="340" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="7" value="&lt;b&gt;6. Mask Extraction &amp; Interior Filling&lt;/b&gt;&lt;br&gt;4-Connected Component Analysis to Isolate Largest Sign&lt;br&gt;External Contour Extraction &amp; Fill Interior Area (cv2.FILLED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="560" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="8" value="&lt;b&gt;7. Final RGB Segmentation&lt;/b&gt;&lt;br&gt;Bitwise-AND with Original Image &amp;rarr; Isolated Sign on Black" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="670" width="340" height="60" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="102" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="103" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="104" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="105" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="106" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="blue_seg_pipeline" name="Blue Color Segmentation Pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Nodes -->
        <mxCell id="2" value="&lt;b&gt;1. Image Input&lt;/b&gt;&lt;br&gt;Load RGB Traffic Sign Image (cv2.imread)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="3" value="&lt;b&gt;2. Preprocessing &amp;amp; Noise Filtering&lt;/b&gt;&lt;br&gt;BGR &amp;rarr; RGB Conversion&lt;br&gt;Bilateral Filter (d=7, &amp;sigma;&lt;sub&gt;Color&lt;/sub&gt;=40, &amp;sigma;&lt;sub&gt;Space&lt;/sub&gt;=40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="340" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="4" value="&lt;b&gt;3. Color Space &amp;amp; Multi-Channel Thresholding&lt;/b&gt;&lt;br&gt;Convert to HSV Color Space&lt;br&gt;Hue Mask [99, 125] &amp;amp; Value Mask [42, 255] (cv2.inRange)&lt;br&gt;Saturation Mask via Adaptive Thresholding &amp;amp; Bitwise-AND Combine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="250" width="400" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="5" value="&lt;b&gt;4. Small Component Removal&lt;/b&gt;&lt;br&gt;8-Connected Component Analysis (cv2.connectedComponentsWithStats)&lt;br&gt;Filter Out Noise Regions &amp;lt; 5% of Total Image Area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="370" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="6" value="&lt;b&gt;5. Morphological Closing&lt;/b&gt;&lt;br&gt;Morphological Closing (4x4 Ellipse Kernel, 1 Iteration)&lt;br&gt;Connect Nearby White Regions &amp;amp; Fill Small Black Gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="480" width="340" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="7" value="&lt;b&gt;6. Mask Extraction &amp;amp; Interior Filling&lt;/b&gt;&lt;br&gt;External Contour Extraction (cv2.findContours)&lt;br&gt;Isolate Largest Sign Contour &amp;amp; Apply Convex Hull (cv2.FILLED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="590" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="8" value="&lt;b&gt;7. Final RGB Segmentation&lt;/b&gt;&lt;br&gt;Bitwise-AND with Original Image &amp;rarr; Isolated Sign on Black Background" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="700" width="380" height="60" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="102" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="103" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="104" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="105" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="106" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="yellow_seg_pipeline" name="Yellow Color Segmentation Pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Nodes -->
        <mxCell id="2" value="&lt;b&gt;1. Image Input&lt;/b&gt;&lt;br&gt;Load Traffic Sign Image (cv2.imread)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="3" value="&lt;b&gt;2. Illumination Correction &amp;amp; Preprocessing&lt;/b&gt;&lt;br&gt;Check Central Region Brightness in HSV V-Channel&lt;br&gt;Apply CLAHE (clipLimit=2.0, tileGridSize=8x8) if Brightness &amp;lt; 140" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="140" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="4" value="&lt;b&gt;3. Color Space &amp;amp; Combined Thresholding&lt;/b&gt;&lt;br&gt;HSV Yellow Mask [5, 80, 30] to [40, 255, 255] (cv2.inRange)&lt;br&gt;Adaptive Gaussian Thresholding on V-Channel (block=51, C=7)&lt;br&gt;Combine Color &amp;amp; Adaptive Masks via Bitwise-AND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="250" width="400" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="5" value="&lt;b&gt;4. Morphological Cleaning&lt;/b&gt;&lt;br&gt;Morphological Closing (3x3 Ellipse Kernel, 1 Iteration)&lt;br&gt;Connect Broken Regions &amp;amp; Fill Small Gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="370" width="340" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="6" value="&lt;b&gt;5. Contour Selection &amp;amp; Scoring&lt;/b&gt;&lt;br&gt;Filter by Area Ratio [0.005, 0.75] of Total Image Area&lt;br&gt;Select Best Contour by Score: &lt;i&gt;Area / (Center Distance + 1)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="470" width="380" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="7" value="&lt;b&gt;6. Boundary Reconstruction &amp;amp; Filling&lt;/b&gt;&lt;br&gt;Evaluate Solidity (Area / Hull Area)&lt;br&gt;If Solidity &amp;lt; 0.90 &amp;rarr; Douglas-Peucker Approx (cv2.approxPolyDP)&lt;br&gt;Draw &amp;amp; Fill Outer Boundary Mask (cv2.FILLED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="580" width="400" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="8" value="&lt;b&gt;7. Final RGB Segmentation&lt;/b&gt;&lt;br&gt;Bitwise-AND with Original Image &amp;rarr; Isolated Yellow Sign on Black Background" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontFamily=Helvetica;fontSize=13;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="700" width="400" height="60" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <mxCell id="101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="102" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="103" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="104" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="105" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="106" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
